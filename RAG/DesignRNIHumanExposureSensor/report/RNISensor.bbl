\bibitem{icnirp2020}
\BIBentryALTinterwordspacing
{International Commission on Non-Ionizing Radiation Protection (ICNIRP)},
  ``Guidelines for limiting exposure to electromagnetic fields (100~{kHz} to
  300~{GHz}),'' \emph{Health Physics}, vol. 118, no.~5, pp. 483--524, May 2020,
  establishes international reference levels and basic restrictions for
  protecting humans exposed to RF EMFs (100~kHz to 300~GHz), replacing 1998
  guidelines for radiofrequencies. [Online]. Available:
  \url{https://doi.org/10.1097/HP.0000000000001210}
\BIBentrySTDinterwordspacing

\bibitem{ane_res773_2023}
{Agencia Nacional del Espectro (ANE)}, ``{Resoluci{\'o}n 773 de 2023: Por la
