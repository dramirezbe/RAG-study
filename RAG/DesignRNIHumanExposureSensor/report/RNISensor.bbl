\bibitem{martinezgonzalez_2022}
\BIBentryALTinterwordspacing
A.~Mart{\'{\i}}nez-Gonz{\'a}lez, J.~Monz{\'o}-Cabrera, A.~J.
  Mart{\'{\i}}nez-S{\'a}ez, and A.~J. Lozano-Guerrero, ``Minimization of
  measuring points for the electric field exposure map generation in indoor
  environments by means of kriging interpolation and selective sampling,''
  \emph{Environmental Research}, vol. 212, p. 113577, May 2022, evaluates
  ordinary Kriging interpolation for indoor electric field exposure mapping and
  proposes the Elimination of Less Significant Points (ELSP) strategy to reduce
  measurement points by up to 70%. [Online]. Available:
  \url{https://doi.org/10.1016/j.envres.2022.113577}
\BIBentrySTDinterwordspacing

